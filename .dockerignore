# VCS
.git
.gitignore
.gitattributes

# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# JavaScript / frontend toolchains (avoid huge accidental build contexts)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs / generated artifacts
build/
dist/
out/
coverage/
.cache/
.tmp/
tmp/

# Local secrets and runtime data — MUST NOT be baked into the image
.env
.env.*
!.env.example
*.db
*.db.*
*.sqlite
*.sqlite3
*.backup
*.save

# Local exports / backups produced while operating Nova
exports/
backups/
memory-packs/
*.tar
*.tar.gz
*.tgz

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# CI / docs that aren't needed at runtime
.github/
tests/
docs/

# Docker meta
Dockerfile
docker-compose*.yml
.dockerignore
